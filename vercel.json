{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --prefix viewer",
  "outputDirectory": "viewer/dist/client",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/workspace", "destination": "/workspace.html" },
    { "source": "/engine", "destination": "/engine.html" },
    { "source": "/account", "destination": "/_pages/account.html" },
    { "source": "/logout", "destination": "/logout.html" },
    { "source": "/signed-out", "destination": "/logout.html" },
    { "source": "/validation", "destination": "/workspace.html" },
    { "source": "/pipeline", "destination": "/workspace.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
